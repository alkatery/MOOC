# Copy this file to `.env` and adjust the values for your environment.

# --- Security ---
# Generate a random string (at least 32 chars) for production deployments.
MOOC_SECRET_KEY=change-me-in-production-this-is-for-local-development-only

# JWT access-token lifetime in minutes (default: 120)
# MOOC_TOKEN_TTL_MIN=120

# --- Database ---
# Default is a local SQLite file inside MOOC_DATA_DIR. Override to use Postgres/MySQL.
# MOOC_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/mooc

# --- Local data directory (uploads, SCORM packages, xAPI dumps, certificates) ---
# MOOC_DATA_DIR=./var/mooc

# --- Uploads ---
# MOOC_MAX_UPLOAD_MB=100

# --- NELC compliance toggles ---
# MOOC_NELC_MODE=true

# --- CORS / trusted hosts (comma-separated) ---
# MOOC_CORS_ORIGINS=*
# MOOC_TRUSTED_HOSTS=*

# --- Runtime ---
# MOOC_DEBUG=false

# --- Local AI assistant (Ollama) ---
# Run Ollama locally (https://ollama.com) and pull an Arabic-capable model:
#   ollama pull llama3.1:8b-instruct
# MOOC_OLLAMA_URL=http://localhost:11434
# MOOC_OLLAMA_MODEL=llama3.1:8b-instruct
# MOOC_AI_TIMEOUT=30
