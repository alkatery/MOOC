# Production .env  — copy to <APP_DIR>/.env and edit.
# VPS path     : /var/www/larning.alkathiri.net/.env
# Hostinger    : /home/u423175456/domains/alkathiri.net/public_html/larning/.env
# Restrict     : chmod 600 .env

# --- Security (CRITICAL: generate a real random key) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MOOC_SECRET_KEY=REPLACE-ME-WITH-A-LONG-RANDOM-STRING-AT-LEAST-48-BYTES

# Session cookie lifetime in minutes
MOOC_TOKEN_TTL_MIN=240

# --- Database (PostgreSQL) ---
# Create the role + db with:
#   sudo -u postgres createuser --pwprompt larning
#   sudo -u postgres createdb -O larning larning_prod -E UTF8 --locale=ar_SA.UTF-8 --template=template0
MOOC_DATABASE_URL=postgresql+psycopg://larning:STRONG-DB-PASSWORD@127.0.0.1:5432/larning_prod

# --- Filesystem layout (writable by www-data) ---
# For VPS:
#   MOOC_DATA_DIR=/var/www/larning.alkathiri.net/var
# For Hostinger / cPanel:
#   MOOC_DATA_DIR=/home/u423175456/domains/alkathiri.net/public_html/larning/var
MOOC_DATA_DIR=/var/www/larning.alkathiri.net/var

# --- Network / hosts ---
MOOC_CORS_ORIGINS=https://larning.alkathiri.net
MOOC_TRUSTED_HOSTS=larning.alkathiri.net

# --- NELC ---
MOOC_NELC_MODE=true

# --- AI assistant (Ollama) ---
# Install Ollama on the same server:
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull llama3.1:8b-instruct
# Leave commented to disable AI gracefully.
# MOOC_OLLAMA_URL=http://127.0.0.1:11434
# MOOC_OLLAMA_MODEL=llama3.1:8b-instruct
# MOOC_AI_TIMEOUT=30

# --- Runtime ---
MOOC_DEBUG=false

# --- Gunicorn tuning (optional overrides) ---
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info
